# Bauverzeichnisse gehoeren NICHT ins Repo. Beides war historisch teilweise
# eingecheckt (138 Dateien unter target/, 12 unter build/, darunter Limine-
# Binaerdateien und ein 7-MB-ISO) -- herausgenommen am 23.08.2026.
# Wer einen Beweis aufheben will, legt ihn woanders ab: das Ergebnis eines
# Testlaufs ist der Commit, der ihn bestanden hat, nicht sein Log.
/target/
/build/

# Der festgenagelte Firn-Uebersetzer wird gebaut, nicht eingecheckt.
# Eingecheckt ist nur vendor/firn/COMMIT und das Bauskript.
/vendor/firn/firnc
/vendor/firn/lib/
/vendor/firn/.bau/
/vendor/firn/.gebaut
/build/firn/

# Der festgenagelte Osum-Kernel wird gebaut, nicht eingecheckt.
# Eingecheckt ist nur vendor/osum/COMMIT und das Bauskript.
/vendor/osum/osum.mb
/vendor/osum/osum.mb.elf
/vendor/osum/.gebaut
