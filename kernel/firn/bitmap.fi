// kernel/firn/bitmap.fi -- der Bitmap-Rahmenverwalter von osum, in Firn.
//
// Ersetzt die Logik von libs/osum-mem/src/bitmap.rs. Ein Bit je 4-KiB-Rahmen,
// gesetzt heisst belegt. Suche nach dem Next-Fit-Verfahren mit Umlauf.
//
// WARUM DIESES MODUL DAS ZWEITE IST
//
// Es haelt KEINEN globalen Zustand. Der Aufrufer besitzt sowohl den
// Bitspeicher als auch den Verwaltungsblock und reicht einen Zeiger herein --
// derselbe Schnitt, den die Rust-Fassung mit `&'a mut [u64]` macht. Firn hat
// bis heute kein `static`; ein Modul, das seinen Zustand selbst haelt, liesse
// sich also gar nicht bauen. Hier faellt das nicht ins Gewicht, weil der
// Entwurf ohnehin so herum richtig ist: wer den Speicher besitzt, entscheidet
// ueber seine Lebensdauer.
//
// WAS FIRN HIER BEITRAEGT, WAS RUST NICHT TAT
//
// Die Rechnungen sind GEPRUEFT (Runde 72/83). In der Rust-Fassung laeuft
// `used - 1` im Release-Bau still um, wenn die Buchhaltung einmal nicht
// stimmt; ab da meldet der Verwalter Milliarden freier Rahmen und vergibt
// Speicher, den es nicht gibt. Hier bricht dieselbe Zeile mit Datei, Zeile,
// Spalte und beiden Zahlen ab.
//
// Wo ein Ueberlauf AUFTRETEN DARF, ohne dass er ein Fehler ist -- die
// Bereichsgrenzen kommen aus der Memory-Map und duerfen ueber das Ende der
// Bitmap hinausragen --, steht das ausdruecklich da: die Grenze wird VORHER
// gekappt, statt sich auf Umlaufverhalten zu verlassen.
//
// AUFRUFRICHTUNG
//
// Nur Rust -> Firn. Die mit `#[export_c]` markierten Funktionen tragen ihren
// Namen unveraendert im Objekt (kein `_F0.`-Praefix), Rust deklariert sie als
// gewoehnliche `extern "C"`.

profile kernel

// -------------------------------------------------------------- Fehlerfaelle

// Dieselben zwei Faelle wie `AllocError` in der Rust-Fassung. Die Zahlen sind
// Teil der Schnittstelle: bm_alloc/bm_free geben sie an Rust zurueck, weil ein
// `E!T` die Sprachgrenze nicht ueberquert.
const OK: u64 = 0
const E_OUT_OF_MEMORY: u64 = 1
const E_OUT_OF_RANGE: u64 = 2

// Rueckgabe von bm_alloc, wenn nichts zu holen war. Ein gueltiger Rahmenindex
// kann diesen Wert nicht annehmen -- er waere groesser als jeder physische
// Speicher, den es gibt.
const KEIN_RAHMEN: u64 = 0xFFFFFFFFFFFFFFFF

const U64MAX: u64 = 0xFFFFFFFFFFFFFFFF
const WORT: u64 = 64
const ALLE_BITS: u64 = 0xFFFFFFFFFFFFFFFF

error BitmapError { OutOfMemory, OutOfRange }

// ------------------------------------------------------------ der Zustandsblock

// Genau die vier Felder der Rust-Struktur, in derselben Reihenfolge.
// `bits` ist die Adresse des Wortfeldes, nicht das Feld selbst -- der Speicher
// dafuer gehoert dem Aufrufer und liegt im fruehen Boot noch vor dem Heap.
struct Bitmap {
    bits: u64,
    frames: u64,
    used: u64,
    cursor: u64,
}

// ------------------------------------------------------------- Bitzugriffe

fn wort_lesen(bits: u64, w: u64) -> u64 {
    return *((bits + w * 8) as *mut u64)
}

fn wort_schreiben(bits: u64, w: u64, v: u64) {
    *((bits + w * 8) as *mut u64) = v
}

// Ist Bit `i` gesetzt? Ohne Bereichspruefung -- die machen die Aufrufer.
fn bit_gesetzt(bm: *mut Bitmap, i: u64) -> bool {
    let w: u64 = wort_lesen((*bm).bits, i / WORT)
    return ((w >> (i % WORT)) & 1) == 1
}

fn bit_setzen(bm: *mut Bitmap, i: u64) {
    let nr: u64 = i / WORT
    let w: u64 = wort_lesen((*bm).bits, nr)
    wort_schreiben((*bm).bits, nr, w | (1 << (i % WORT)))
}

fn bit_loeschen(bm: *mut Bitmap, i: u64) {
    let nr: u64 = i / WORT
    let w: u64 = wort_lesen((*bm).bits, nr)
    wort_schreiben((*bm).bits, nr, w & (ALLE_BITS ^ (1 << (i % WORT))))
}

// ------------------------------------------------------------------ Aufbau

// Anzahl u64-Woerter fuer `frames` Rahmen, aufgerundet.
//
// `frames + 63` ist die eine Stelle, an der ein Aufrufer mit einem absurden
// Wert einen Ueberlauf ausloesen koennte. Die Pruefung faengt das ab und
// liefert 0 -- der Aufrufer sieht dann eine Bitmap, in die nichts passt,
// statt einer, die viel zu klein ist.
#[export_c]
fn bm_words_needed(frames: u64) -> u64 {
    if frames > U64MAX - (WORT - 1) {
        return 0
    }
    return (frames + (WORT - 1)) / WORT
}

// Legt eine Bitmap an, in der ZUNAECHST ALLES als belegt gilt. Freigegeben
// wird gezielt ueber bm_free_range -- so kann kein Rahmen versehentlich
// nutzbar erscheinen, den die Memory-Map nie genannt hat.
//
// `woerter` ist die Groesse des Bitspeichers. Liefert false, wenn er zu klein
// ist; die Rust-Fassung bricht an dieser Stelle mit `assert!` ab. Ein
// Rueckgabewert ist hier das bessere Mittel: der Aufrufer im fruehen Boot kann
// darauf noch sinnvoll reagieren, ein Panic nicht.
#[export_c]
fn bm_init(bm: *mut Bitmap, bits: u64, woerter: u64, frames: u64) -> bool {
    if woerter < bm_words_needed(frames) {
        return false
    }
    var w: u64 = 0
    while w < woerter {
        wort_schreiben(bits, w, ALLE_BITS)
        w = w + 1
    }
    (*bm).bits = bits
    (*bm).frames = frames
    (*bm).used = frames
    (*bm).cursor = 0
    return true
}

#[export_c]
fn bm_frames(bm: *mut Bitmap) -> u64 {
    return (*bm).frames
}

#[export_c]
fn bm_used_frames(bm: *mut Bitmap) -> u64 {
    return (*bm).used
}

#[export_c]
fn bm_free_frames(bm: *mut Bitmap) -> u64 {
    return (*bm).frames - (*bm).used
}

// Gilt der Rahmen als belegt? Alles hinter dem Ende gilt als belegt -- das ist
// die Zusage, auf der der Aufrufer sich ausruht, wenn er einen Index aus einer
// physischen Adresse errechnet hat und sich verrechnet haben koennte.
#[export_c]
fn bm_is_used(bm: *mut Bitmap, i: u64) -> bool {
    if i >= (*bm).frames {
        return true
    }
    return bit_gesetzt(bm, i)
}

// ------------------------------------------------------------- Bereiche

// Kappt eine obere Grenze auf das Ende der Bitmap.
//
// Die Grenzen kommen aus der Memory-Map des Bootloaders und ragen regelmaessig
// darueber hinaus -- das ist kein Fehler, sondern der Normalfall. Deshalb wird
// hier gekappt und nicht geprueft.
fn kappen(bm: *mut Bitmap, ende: u64) -> u64 {
    if ende > (*bm).frames {
        return (*bm).frames
    }
    return ende
}

// Markiert [start, ende) als frei. Mehrfach aufgerufen bleibt der Zaehler
// richtig, weil nur wirklich gesetzte Bits gezaehlt werden.
#[export_c]
fn bm_free_range(bm: *mut Bitmap, start: u64, ende: u64) {
    let stop: u64 = kappen(bm, ende)
    var i: u64 = start
    while i < stop {
        if bit_gesetzt(bm, i) {
            bit_loeschen(bm, i)
            (*bm).used = (*bm).used - 1
        }
        i = i + 1
    }
}

// Markiert [start, ende) als belegt -- Kernelabbild, die Bitmap selbst,
// alles, was der Bootloader fuer sich behalten hat.
#[export_c]
fn bm_reserve_range(bm: *mut Bitmap, start: u64, ende: u64) {
    let stop: u64 = kappen(bm, ende)
    var i: u64 = start
    while i < stop {
        if !bit_gesetzt(bm, i) {
            bit_setzen(bm, i)
            (*bm).used = (*bm).used + 1
        }
        i = i + 1
    }
}

// ----------------------------------------------------------- Vergabe

// Sucht `anzahl` zusammenhaengende freie Rahmen nach dem Next-Fit-Verfahren
// und belegt sie.
//
// ZUR TERMINIERUNG: die Suche laeuft ueber ein Budget, das jeden Kandidaten
// hoechstens einmal zulaesst. Ohne das dreht sich die Schleife bei voller
// Bitmap endlos -- sie setzt `i` immer wieder auf 0 und kommt nie bis zum
// Startzeiger zurueck. Dieser Fehler steckte in einer frueheren Fassung der
// Rust-Datei und ist teuer gefunden worden; die Kommentare dort halten ihn
// fest. Er wird hier nicht wiederholt.
fn suchen(bm: *mut Bitmap, anzahl: u64) -> BitmapError!u64 {
    if anzahl == 0 {
        return BitmapError::OutOfMemory
    }
    if anzahl > (*bm).frames {
        return BitmapError::OutOfMemory
    }

    // Letzter moeglicher Startindex; es gibt genau `letzter_start + 1`
    // Kandidaten.
    let letzter_start: u64 = (*bm).frames - anzahl

    // Der Suchzeiger darf hinter dem letzten Kandidaten stehen. Dann faengt
    // die Suche vorne an.
    var i: u64 = (*bm).cursor
    if i > letzter_start {
        i = 0
    }

    var budget: u64 = letzter_start + 1
    while budget > 0 {
        if i > letzter_start {
            // Umlauf. Danach gilt wieder i <= letzter_start, dieser Zweig
            // kann sich also nicht wiederholen.
            i = 0
        }

        // Wortweiser Schnellvorlauf: ein volles Wort enthaelt keinen
        // einzelnen freien Rahmen, also 64 Kandidaten auf einmal ueberspringen.
        if anzahl == 1 {
            if i % WORT == 0 {
                if wort_lesen((*bm).bits, i / WORT) == ALLE_BITS {
                    i = i + WORT
                    if budget > WORT {
                        budget = budget - WORT
                    } else {
                        budget = 0
                    }
                    continue
                }
            }
        }

        // Fenster [i, i+anzahl) pruefen. `j` bleibt beim ersten belegten
        // Rahmen stehen -- alle Startpositionen bis dahin sind erledigt.
        var j: u64 = i
        var frei: bool = true
        while j < i + anzahl {
            if bit_gesetzt(bm, j) {
                frei = false
                break
            }
            j = j + 1
        }

        if frei {
            var k: u64 = i
            while k < i + anzahl {
                bit_setzen(bm, k)
                k = k + 1
            }
            (*bm).used = (*bm).used + anzahl
            (*bm).cursor = i + anzahl
            return i
        }

        let verbraucht: u64 = j + 1 - i
        if budget > verbraucht {
            budget = budget - verbraucht
        } else {
            budget = 0
        }
        i = j + 1
    }
    return BitmapError::OutOfMemory
}

// Ein einzelner Rahmen. KEIN_RAHMEN, wenn keiner mehr frei ist.
#[export_c]
fn bm_alloc(bm: *mut Bitmap) -> u64 {
    return suchen(bm, 1) catch |e| (KEIN_RAHMEN)
}

// `anzahl` zusammenhaengende Rahmen. KEIN_RAHMEN, wenn es sie nicht gibt.
#[export_c]
fn bm_alloc_contiguous(bm: *mut Bitmap, anzahl: u64) -> u64 {
    return suchen(bm, anzahl) catch |e| (KEIN_RAHMEN)
}

// ---------------------------------------------------------------- Rueckgabe

fn zurueckgeben(bm: *mut Bitmap, index: u64, anzahl: u64) -> BitmapError!u64 {
    // Ueberlaufsicher, aber OHNE Abbruch: ein verrutschter Index ist hier ein
    // erwarteter Fehlerfall, kein Programmfehler. Der Aufrufer leitet ihn aus
    // einer physischen Adresse ab -- also aus Daten, die auch falsch sein
    // koennen. `index + anzahl` wuerde umlaufen und dann Rahmen am ANFANG der
    // Bitmap freigeben, die jemand anderem gehoeren; deshalb wird die Summe
    // gar nicht erst gebildet.
    if anzahl > U64MAX - index {
        return BitmapError::OutOfRange
    }
    if index + anzahl > (*bm).frames {
        return BitmapError::OutOfRange
    }

    var i: u64 = index
    while i < index + anzahl {
        if bit_gesetzt(bm, i) {
            bit_loeschen(bm, i)
            (*bm).used = (*bm).used - 1
        }
        i = i + 1
    }
    if index < (*bm).cursor {
        (*bm).cursor = index
    }
    return OK
}

// Gibt `anzahl` Rahmen ab `index` frei. OK oder E_OUT_OF_RANGE.
// Ein doppelter Aufruf bleibt buchhalterisch richtig, weil nur wirklich
// gesetzte Bits gezaehlt werden.
#[export_c]
fn bm_free(bm: *mut Bitmap, index: u64, anzahl: u64) -> u64 {
    return zurueckgeben(bm, index, anzahl) catch |e| (E_OUT_OF_RANGE)
}
