// kernel/firn/serial.fi -- 16550 UART on COM1, the debug console of the early boot.
//
// THE FIRST OSUM MODULE IN FIRN. It replaces kernel/src/arch/x86_64/serial.rs
// one to one -- same ports, same divisor, same emergency brake.
//
// Deliberately WITHOUT a lock: the panic handler has to be able to write even
// when an interrupt has struck in the middle of an output. A spinlock would
// deadlock in exactly that situation. As long as only one CPU runs this is
// harmless; with SMP a per CPU buffer follows (see ROADMAP.md).
//
// Why this module was the bridgehead: it is a LEAF. It calls nothing outside
// itself and it keeps no state. At the time that mattered, because stage 0 of
// Firn had neither `extern fn` nor `static`. Round 75 lifted the first of those
// -- calls now work in both directions -- so the leaf property is no longer a
// constraint here, only a convenience. See LANGUAGE.md.
//
// One outside name remains and cannot be avoided: `osum_panic`. Since round
// 72/83 the arithmetic in this file is CHECKED, and the kernel profile hands a
// failed check to that external symbol. osum defines it in
// kernel/src/kcore/firn_panic.rs.
//
// Port I/O is the one thing that cannot be expressed with pointers: `in` and
// `out` are instructions of their own with an address space of their own.
// Hence inline assembly.

profile kernel

// Base port of COM1.
const COM1: u16 = 0x3F8

// Register offsets relative to the base.
const INT_EN: u16 = 1
const FIFO_CTL: u16 = 2
const LINE_CTL: u16 = 3
const MODEM_CTL: u16 = 4
const LINE_STATUS: u16 = 5

// The emergency brake of serial_write_byte: if no UART answers, the kernel
// must not hang. The same number as in the Rust original.
const SPIN_LIMIT: u64 = 1000000

// Maske fuer ein Oktett, als u64 -- ein blankes `0xFF` waere ein u8 und Firn
// rechnet nicht zwischen Typen, ohne dass es dasteht.
const OCTET: u64 = 0xFF

// ------------------------------------------------------------------ port I/O

fn out8(port: u16, value: u8) {
    asm("out dx, al", in("dx") port, in("al") value)
}

// `in al, dx` schreibt NUR `al`. Die oberen 56 Bit von `rax` behalten, was
// vorher darin stand -- der Assembler sagt darueber nichts zu.
//
// Deshalb steht hier eine Maske und nicht bloss ein `as u8`: seit Firn-Runde
// 72/83 ist die Bereichsumwandlung GEPRUEFT. Ein `as u8` auf ein `rax` mit
// Resten in den oberen Bits ruft `osum_panic` -- und weil der Panikpfad seine
// Meldung ueber genau diese serielle Konsole schreiben will, endet das in einer
// Rekursion, die den Boot vor der ersten Zeile Ausgabe anhaelt. Genau so ist es
// beim Uebersetzerwechsel auf 4536a191 passiert.
//
// Die Maske ist auch fachlich das Richtige: das Register enthaelt genau ein
// Oktett Nutzdaten, alles darueber ist keine Information.
fn in8(port: u16) -> u8 {
    return (asm("in al, dx", out("rax"), in("dx") port) & OCTET) as u8
}

// --------------------------------------------------------------------- setup

// Sets up COM1 to 115200 8N1 with the FIFO switched on.
// Programs hardware; exactly once during the boot.
fn serial_init() {
    out8(COM1 + INT_EN, 0x00 as u8)     // interrupts off -- we poll
    out8(COM1 + LINE_CTL, 0x80 as u8)   // DLAB on: the divisor becomes visible
    out8(COM1, 0x01 as u8)              // divisor 1 = 115200 baud
    out8(COM1 + INT_EN, 0x00 as u8)     // divisor, high byte
    out8(COM1 + LINE_CTL, 0x03 as u8)   // 8 bits, no parity, 1 stop bit
    out8(COM1 + FIFO_CTL, 0xC7 as u8)   // FIFO on, cleared, threshold 14 bytes
    out8(COM1 + MODEM_CTL, 0x0B as u8)  // DTR + RTS + OUT2
}

// Bit 5 = transmitter holding register empty.
fn ready() -> bool {
    return (in8(COM1 + LINE_STATUS) & 0x20 as u8) != 0 as u8
}

// -------------------------------------------------------------------- output

// A single octet, blocking -- but never longer than SPIN_LIMIT turns.
fn serial_write_byte(b: u8) {
    var spins: u64 = 0
    while !ready() {
        spins = spins + 1
        if spins > SPIN_LIMIT {
            return
        }
    }
    out8(COM1, b)
}

// `n` octets from `p`. A newline becomes CR LF so that terminals wrap cleanly
// -- exactly what write_str did in the Rust version.
//
// The caller passes address and length instead of a string: the kernel profile
// has no string type (that lives in the standard library, and that one is
// barred here), and a Firn function cannot take a Rust `&str` anyway.
fn serial_write_bytes(p: u64, n: u64) {
    var i: u64 = 0
    while i < n {
        let c: u8 = *((p + i) as *mut u8)
        if c == 10 as u8 {
            serial_write_byte(13 as u8)
        }
        serial_write_byte(c)
        i = i + 1
    }
}
