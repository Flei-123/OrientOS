profile kernel

struct S { a: u64, b: u64, c: u64 }

fn nebenwirkung(p: u64, w: u64, v: u64) {
    *((p + w * 8) as *mut u64) = v
}

// Der Parameter `frames` lebt UEBER die Schleife (und damit ueber mehrere
// Aufrufe) hinweg und wird erst danach benutzt.
#[export_c]
fn init(s: *mut S, bits: u64, woerter: u64, frames: u64) {
    var w: u64 = 0
    while w < woerter {
        nebenwirkung(bits, w, 0xFFFFFFFFFFFFFFFF)
        w = w + 1
    }
    (*s).a = bits
    (*s).b = frames
    (*s).c = frames
}
