profile kernel

// Ein Byteleser, wie ihn jeder Parser braucht.
fn rd8(p: u64, off: u64) -> u64 {
    let b: u8 = *((p + off) as *mut u8)
    return b as u64
}

#[export_c]
fn rd16(p: u64, off: u64) -> u64 {
    return rd8(p, off) | (rd8(p, off + 1) << 8)
}

#[export_c]
fn rd64k(p: u64, off: u64) -> u64 {
    return rd16(p, off) | (rd16(p, off + 2) << 16)
}
